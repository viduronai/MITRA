# Compose values for one environment. Copy to /opt/mitra/.env on the server (never commit it).
# Generate secrets with:  openssl rand -base64 36

# Hosts are <domain>, api.<domain>, site.<domain>, voice.<domain> (deploy/Caddyfile).
MITRA_DOMAIN=staging.viduronai.in
# true = X-Robots-Tag noindex on every host (staging, demo). false only for production.
MITRA_NOINDEX=true
# Staging only (test data): show the login code on the login screen. 0 everywhere else.
MITRA_SHOW_DEV_OTP=1

# Images pushed by GitHub Actions: ghcr.io/<github owner>, tag = the commit SHA being deployed.
MITRA_IMAGE_PREFIX=ghcr.io/OWNER
MITRA_TAG=latest-staging

# Password of the `mitra` Postgres owner. The same value goes into
# MITRA_MIGRATION_DATABASE_URL in env/core.env.
POSTGRES_PASSWORD=
