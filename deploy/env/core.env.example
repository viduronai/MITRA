# Core API, scheduler and migrations. Copy to /opt/mitra/env/core.env (never commit it).
# Every secret below is different per environment. Generate: openssl rand -base64 36
MITRA_ENV=staging
MITRA_LOG_LEVEL=INFO

# mitra_app = the API's non-superuser role (RLS applies); the migration creates it with this
# password. mitra = the owner, password = POSTGRES_PASSWORD in ../.env.
MITRA_DATABASE_URL=postgresql+asyncpg://mitra_app:CHANGE_APP_PASSWORD@postgres:5432/mitra
MITRA_MIGRATION_DATABASE_URL=postgresql+asyncpg://mitra:CHANGE_POSTGRES_PASSWORD@postgres:5432/mitra

MITRA_JWT_SECRET=
MITRA_PHONE_HASH_KEY=
MITRA_OTP_HASH_KEY=
# Shared with the voice service (MITRA_CORE_SERVICE_TOKEN in voice.env). 32+ chars.
MITRA_SERVICE_TOKEN=

# Customer phone numbers are encrypted under this master key; set ONE source and never change
# it once numbers are stored (src/mitra_core/keystore.py). Preferred: a KMS-encrypted data key
#   docker compose run --rm core python -m mitra_core.keystore new-kms-key --key-id alias/mitra-staging
# (needs AWS credentials with kms:GenerateDataKeyWithoutPlaintext + kms:Decrypt on that key).
MITRA_PHONE_ENC_KEY_KMS=
MITRA_KMS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Staging only, test data: show the login code on screen (no SMS/WhatsApp delivery yet).
# Refused in prod. Pair with MITRA_SHOW_DEV_OTP=1 on the web container.
MITRA_OTP_SHOW_CODE=true

# Public URLs (links in WhatsApp messages, lead-intake URLs).
MITRA_APP_BASE_URL=https://staging.viduronai.in
MITRA_PUBLIC_API_URL=https://api.staging.viduronai.in

# Providers. Staging may keep the simulators; prod must use the real ones.
MITRA_PAYMENT_PROVIDER=mock
MITRA_COLLECTIONS_PROVIDER=sim
MITRA_TELEPHONY_CARRIER=sim
MITRA_WHATSAPP_PROVIDER=sim
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
