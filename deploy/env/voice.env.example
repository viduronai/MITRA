# Voice service. Copy to /opt/mitra/env/voice.env (never commit it).
MITRA_ENV=staging
# Same value as MITRA_SERVICE_TOKEN in core.env.
MITRA_CORE_SERVICE_TOKEN=

# Public https base of this service (carrier media streams, test page).
MITRA_PUBLIC_BASE_URL=https://voice.staging.viduronai.in
# The server sits behind NAT: STUN tells WebRTC its public address.
MITRA_WEBRTC_ICE_SERVERS=["stun:stun.l.google.com:19302"]

# Speech + LLM (see services/voice/.env.example for every option).
MITRA_STT=sarvam
MITRA_LLM=groq
MITRA_TTS=sarvam
SARVAM_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

MITRA_TELEPHONY_CARRIER=sim
