# Copy to .env for local overrides. All settings use the MITRA_ prefix (src/mitra_core/config.py).
MITRA_ENV=local
MITRA_LOG_LEVEL=INFO

# API connects as the NON-superuser app role (RLS applies). The initial migration creates this
# role using the username/password in this URL.
MITRA_DATABASE_URL=postgresql+asyncpg://mitra_app:mitra_app_dev_password@localhost:5433/mitra
# Migrations run as the schema owner.
MITRA_MIGRATION_DATABASE_URL=postgresql+asyncpg://mitra:mitra_dev_password@localhost:5433/mitra

# Dev-only secrets; MUST be overridden in staging/prod (startup fails otherwise).
MITRA_JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789
MITRA_PHONE_HASH_KEY=dev-only-insecure-phone-hash-key-change-me
MITRA_OTP_HASH_KEY=dev-only-insecure-otp-hash-key-change-me
# Master key for encrypted customer phone numbers (mitra_core.keystore). Staging/prod MUST
# set exactly one, and never change it once numbers are stored:
#   MITRA_PHONE_ENC_KEY_KMS = base64 KMS ciphertext of a data key (preferred; needs the "aws"
#     extra + kms:Decrypt). Make one: python -m mitra_core.keystore new-kms-key --key-id alias/mitra-staging
#   MITRA_PHONE_ENC_KEY_FILE = path to a Docker secret, e.g. /run/secrets/phone_enc_key
#   MITRA_PHONE_ENC_KEY = the key itself (32+ random chars)
# Local: leave all unset (derived from MITRA_PHONE_HASH_KEY).
# MITRA_PHONE_ENC_KEY_KMS=
# MITRA_PHONE_ENC_KEY_FILE=
# MITRA_PHONE_ENC_KEY=
# MITRA_KMS_REGION=ap-south-1
# Service-to-service token for /internal/v1 (voice service). Empty = dev placeholder in
# env=local, internal API disabled elsewhere. Use 32+ random chars outside local.
MITRA_SERVICE_TOKEN=
# Where the background-job scheduler reaches this API (python -m mitra_core.scheduler).
MITRA_SCHEDULER_API_URL=http://localhost:8000

# Wallet top-ups: "mock" (default, local only: payments succeed instantly) or "razorpay".
MITRA_PAYMENT_PROVIDER=mock
# Razorpay (test-mode keys work). Read without the MITRA_ prefix. Leave empty for mock.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Owner app address, used in WhatsApp "Open in Mitra" / "Open report" buttons.
# Production: https://app.viduronai.in
MITRA_APP_BASE_URL=http://localhost:3000
