# Copy to .env for local overrides. All settings use the MITRA_ prefix (src/mitra_core/config.py).
MITRA_ENV=local
MITRA_LOG_LEVEL=INFO

# API connects as the NON-superuser app role (RLS applies). The initial migration creates this
# role using the username/password in this URL.
MITRA_DATABASE_URL=postgresql+asyncpg://mitra_app:mitra_app_dev_password@localhost:5433/mitra
# Migrations run as the schema owner.
MITRA_MIGRATION_DATABASE_URL=postgresql+asyncpg://mitra:mitra_dev_password@localhost:5433/mitra

# Dev-only secrets; MUST be overridden in staging/prod (startup fails otherwise).
MITRA_JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789
MITRA_PHONE_HASH_KEY=dev-only-insecure-phone-hash-key-change-me
MITRA_OTP_HASH_KEY=dev-only-insecure-otp-hash-key-change-me
# Service-to-service token for /internal/v1 (voice service). Empty = dev placeholder in
# env=local, internal API disabled elsewhere. Use 32+ random chars outside local.
MITRA_SERVICE_TOKEN=
