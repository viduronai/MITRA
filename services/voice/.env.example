# Copy to .env (gitignored) and fill in. Never commit real values.
# local | dev | staging | prod. Only "local" falls back to mocks when a key is missing.
MITRA_ENV=local

# Provider selection
MITRA_STT=mock          # mock | sarvam | deepgram
MITRA_LLM=mock          # mock | anthropic
MITRA_TTS=mock          # mock | sarvam | elevenlabs
MITRA_TURN=smart        # smart (Silero VAD + Smart Turn v3) | vad (silence timeout)

# Provider keys
SARVAM_API_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Live-turn LLM: a fast Claude model (Haiku-class). Required when MITRA_LLM=anthropic; no default.
MITRA_LLM_MODEL=
# Optional provider overrides (empty = the Pipecat adapter's default)
MITRA_STT_MODEL=
MITRA_TTS_MODEL=
MITRA_TTS_VOICE=        # required for elevenlabs (voice id)

# Employee pack from services/core (stub until core has a service-auth pack endpoint)
MITRA_CORE_URL=
MITRA_CORE_SERVICE_TOKEN=

# Mock latency simulation (ms)
MOCK_LLM_TTFT_MS=250
MOCK_LLM_TOKEN_MS=20
MOCK_TOOL_LATENCY_MS=600
MOCK_TTS_TTFB_MS=90
MOCK_TTS_MS_PER_CHAR=55
