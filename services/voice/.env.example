# Copy to .env (gitignored) and fill in. Never commit real values.
# local | dev | staging | prod. Only "local" falls back to mocks when a key is missing.
MITRA_ENV=local

# Provider selection
MITRA_STT=mock          # mock | sarvam | deepgram
MITRA_LLM=mock          # mock | anthropic | gemini
MITRA_TTS=mock          # mock | sarvam | elevenlabs
MITRA_TURN=smart        # smart (Silero VAD + Smart Turn v3) | vad (silence timeout)

# Provider keys
SARVAM_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Live-turn LLM model. Required when MITRA_LLM=anthropic or gemini; no default in code.
MITRA_LLM_MODEL=
# Gemini brain (MITRA_LLM=gemini): MITRA_LLM_MODEL is a fast Flash-class model; no default.
# Optional stronger model for background/hard turns.
MITRA_LLM_MODEL_SLOW=
MITRA_LLM_FIRST_TOKEN_TIMEOUT_S=1.5
# Optional provider overrides (empty = the Pipecat adapter's default)
MITRA_STT_MODEL=
MITRA_TTS_MODEL=
MITRA_TTS_VOICE=        # required for elevenlabs; for sarvam overrides the catalog speaker (voices.py)

# Turn-taking and latency (see src/mitra_voice/turn_tuning.py and docs/ADR-002-spike-notes.md)
MITRA_VAD_STOP_MS=200               # also triggers Sarvam's transcript flush; 120 fragmented utterances
MITRA_SMART_TURN_MAX_SILENCE_MS=    # empty = per-language caps (te/hi 1.2 s, en 2.0 s)
MITRA_TTS_MIN_BUFFER=30             # Sarvam Bulbul chars buffered before synthesis (API minimum 30)
MITRA_TTS_FIRST_CHUNK_WORDS=5       # send a reply's first words to TTS early; 0 = whole first clause

# Dev only: save each assistant utterance as WAV here; log loop stalls with stacks
MITRA_RECORD_DIR=
MITRA_LOOP_WATCHDOG=false

# Employee pack from services/core (GET /internal/v1/employees/{id}/pack, Bearer service token =
# core's MITRA_SERVICE_TOKEN). Used when an offer carries employee_id; else scenario fixtures.
MITRA_CORE_URL=
MITRA_CORE_SERVICE_TOKEN=

# Mock latency simulation (ms)
MOCK_LLM_TTFT_MS=250
MOCK_LLM_TOKEN_MS=20
MOCK_TOOL_LATENCY_MS=600
MOCK_TTS_TTFB_MS=90
MOCK_TTS_MS_PER_CHAR=55
